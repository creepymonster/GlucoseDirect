# Fastfile for GlucoseDirect — automated TestFlight build via GitHub Actions.
# Mirrors the proven "browser build" pattern used by LoopWorkspace so the same
# secrets (TEAMID, GH_PAT, FASTLANE_KEY_ID, FASTLANE_ISSUER_ID, FASTLANE_KEY,
# MATCH_PASSWORD) drive both projects.
#
# Docs: https://docs.fastlane.tools

default_platform(:ios)

TEAMID = ENV["TEAMID"]
GH_PAT = ENV["GH_PAT"]
GITHUB_WORKSPACE = ENV["GITHUB_WORKSPACE"] || File.expand_path("..", __dir__)
GITHUB_REPOSITORY_OWNER = ENV["GITHUB_REPOSITORY_OWNER"]
FASTLANE_KEY_ID = ENV["FASTLANE_KEY_ID"]
FASTLANE_ISSUER_ID = ENV["FASTLANE_ISSUER_ID"]
FASTLANE_KEY = ENV["FASTLANE_KEY"]
ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"

# Bundle identifiers are derived from the developer Team ID so every user builds
# under their own namespace. The App Group is intentionally kept identical to
# Loop's group so GlucoseDirect and Loop can share glucose readings.
MAIN_APP_ID = "com.#{TEAMID}.glucosedirect"
WIDGET_APP_ID = "com.#{TEAMID}.glucosedirect.Widgets"
APP_GROUP_ID = "group.com.#{TEAMID}.loopkit.LoopGroup"

PROJECT = "#{GITHUB_WORKSPACE}/GlucoseDirect.xcodeproj"
OVERRIDE_XCCONFIG = "#{GITHUB_WORKSPACE}/GlucoseDirectOverride.xcconfig"

# Write a build-time override xcconfig from the Team ID secret. This does NOT
# touch the committed source logic — it only injects the signing team and the
# per-user bundle identifier at build time.
def write_override_xcconfig
  File.write(OVERRIDE_XCCONFIG, <<~CONFIG)
    // Generated by fastlane at build time — do not edit.
    DEVELOPMENT_TEAM = #{TEAMID}
    PRODUCT_BUNDLE_IDENTIFIER = com.$(DEVELOPMENT_TEAM).glucosedirect
    APP_AUTHOR = GlucoseDirect
    APP_SUPPORT_MAIL = glucosedirect@icloud.com
  CONFIG
end

platform :ios do
  desc "Build GlucoseDirect and archive a signed IPA"
  lane :build_glucosedirect do
    setup_ci if ENV['CI']

    write_override_xcconfig

    update_project_team(
      path: PROJECT,
      teamid: "#{TEAMID}"
    )

    api_key = app_store_connect_api_key(
      key_id: "#{FASTLANE_KEY_ID}",
      issuer_id: "#{FASTLANE_ISSUER_ID}",
      key_content: "#{FASTLANE_KEY}"
    )

    # On the very first upload the App Store Connect app record may have no
    # builds yet (or the lookup may momentarily fail); fall back to 1 so the
    # first TestFlight build always succeeds. The app record itself must exist
    # (create it once under App Store Connect > My Apps).
    current_build_number = 1
    begin
      previous_build_number = latest_testflight_build_number(
        app_identifier: MAIN_APP_ID,
        api_key: api_key,
        initial_build_number: 0
      )
      current_build_number = previous_build_number + 1
    rescue => e
      UI.important("Could not read latest TestFlight build number, defaulting to 1: #{e.message}")
    end

    increment_build_number(
      xcodeproj: PROJECT,
      build_number: current_build_number
    )

    # setup_ci enables match readonly mode by default; disable it here so match
    # can regenerate profiles. force: true regenerates the provisioning profiles
    # on every build so they always reflect the current capabilities (App Groups,
    # HealthKit, NFC, Time Sensitive Notifications). Without regeneration, a
    # profile created before a capability was added stays stale and gym fails
    # with entitlement mismatches.
    match(
      type: "appstore",
      readonly: false,
      force: true,
      git_basic_authorization: Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}"),
      app_identifier: [MAIN_APP_ID, WIDGET_APP_ID]
    )

    mapping = Actions.lane_context[
      SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING
    ]

    update_code_signing_settings(
      path: PROJECT,
      profile_name: mapping[MAIN_APP_ID],
      code_sign_identity: "iPhone Distribution",
      targets: ["GlucoseDirectApp"]
    )

    update_code_signing_settings(
      path: PROJECT,
      profile_name: mapping[WIDGET_APP_ID],
      code_sign_identity: "iPhone Distribution",
      targets: ["GlucoseDirectWidget"]
    )

    gym(
      export_method: "app-store",
      scheme: "GlucoseDirectApp",
      output_name: "GlucoseDirect.ipa",
      configuration: "Release",
      destination: "generic/platform=iOS",
      buildlog_path: "buildlog"
    )

    copy_artifacts(
      target_path: "artifacts",
      artifacts: ["*.mobileprovision", "*.ipa", "*.dSYM.zip"]
    )
  end

  desc "Upload the built IPA to TestFlight"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: "#{FASTLANE_KEY_ID}",
      issuer_id: "#{FASTLANE_ISSUER_ID}",
      key_content: "#{FASTLANE_KEY}"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_submission: false,
      ipa: "GlucoseDirect.ipa",
      skip_waiting_for_build_processing: true
    )
  end

  desc "Register App Identifiers, capabilities and the shared App Group"
  lane :identifiers do
    setup_ci if ENV['CI']
    ENV["MATCH_READONLY"] = false.to_s

    app_store_connect_api_key(
      key_id: "#{FASTLANE_KEY_ID}",
      issuer_id: "#{FASTLANE_ISSUER_ID}",
      key_content: "#{FASTLANE_KEY}"
    )

    def configure_bundle_id(name, identifier, capabilities)
      bundle_id = Spaceship::ConnectAPI::BundleId.find(identifier) || Spaceship::ConnectAPI::BundleId.create(
        name:       name,
        identifier: identifier,
        platform:   "IOS"
      )
      existing = bundle_id.get_capabilities.map(&:capability_type)
      capabilities.reject { |c| existing.include?(c) }.each do |cap|
        # Best effort: some capability strings may not be recognised by every
        # App Store Connect API version. Don't let one unknown capability abort
        # the whole run — the developer portal steps in the docs cover the rest.
        begin
          bundle_id.create_capability(cap)
          UI.success("Enabled #{cap} on #{identifier}")
        rescue => e
          UI.important("Could not enable #{cap} on #{identifier}: #{e.message}")
        end
      end
    end

    # Capability type strings understood by the App Store Connect API.
    time_sensitive = "USERNOTIFICATIONS_TIMESENSITIVE"

    configure_bundle_id("GlucoseDirect", MAIN_APP_ID, [
      Spaceship::ConnectAPI::BundleIdCapability::Type::APP_GROUPS,
      Spaceship::ConnectAPI::BundleIdCapability::Type::HEALTHKIT,
      Spaceship::ConnectAPI::BundleIdCapability::Type::NFC_TAG_READING,
      time_sensitive
    ])

    configure_bundle_id("GlucoseDirect Widgets", WIDGET_APP_ID, [
      Spaceship::ConnectAPI::BundleIdCapability::Type::APP_GROUPS
    ])

    # Create the shared App Group (same one Loop uses) and associate it with
    # both App IDs so the generated profiles carry the application-groups
    # entitlement value that the entitlements files expect. Best effort — if the
    # API surface differs, follow the developer-portal steps in testflight.md.
    begin
      require "spaceship"
      group = Spaceship::ConnectAPI::AppGroup.all.find { |g| g.identifier == APP_GROUP_ID } ||
              Spaceship::ConnectAPI::AppGroup.create(identifier: APP_GROUP_ID, name: "Loop App Group")
      [MAIN_APP_ID, WIDGET_APP_ID].each do |identifier|
        bundle_id = Spaceship::ConnectAPI::BundleId.find(identifier)
        next unless bundle_id && group
        already = bundle_id.app_groups.map(&:id) rescue []
        bundle_id.add_app_group(group.id) unless already.include?(group.id)
        UI.success("Associated #{APP_GROUP_ID} with #{identifier}")
      end
    rescue => e
      UI.important("Automatic App Group setup skipped (#{e.message}). See testflight.md to add '#{APP_GROUP_ID}' in the developer portal.")
    end
  end

  desc "Create or renew the Distribution certificate and provisioning profiles"
  lane :certs do
    setup_ci if ENV['CI']
    ENV["MATCH_READONLY"] = false.to_s

    app_store_connect_api_key(
      key_id: "#{FASTLANE_KEY_ID}",
      issuer_id: "#{FASTLANE_ISSUER_ID}",
      key_content: "#{FASTLANE_KEY}"
    )

    match(
      type: "appstore",
      force: false,
      verbose: true,
      git_basic_authorization: Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}"),
      app_identifier: [MAIN_APP_ID, WIDGET_APP_ID]
    )
  end

  desc "Validate that all required secrets are present and usable"
  lane :validate_secrets do
    setup_ci if ENV['CI']
    ENV["MATCH_READONLY"] = true.to_s

    app_store_connect_api_key(
      key_id: "#{FASTLANE_KEY_ID}",
      issuer_id: "#{FASTLANE_ISSUER_ID}",
      key_content: "#{FASTLANE_KEY}"
    )

    match(
      type: "appstore",
      git_basic_authorization: Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}"),
      app_identifier: []
    )
  end

  desc "Nuke and recreate the Distribution certificate"
  lane :nuke_certs do
    setup_ci if ENV['CI']
    ENV["MATCH_READONLY"] = false.to_s

    app_store_connect_api_key(
      key_id: "#{FASTLANE_KEY_ID}",
      issuer_id: "#{FASTLANE_ISSUER_ID}",
      key_content: "#{FASTLANE_KEY}"
    )

    match_nuke(
      type: "appstore",
      team_id: "#{TEAMID}",
      skip_confirmation: true,
      git_basic_authorization: Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}")
    )
  end

  desc "Check the Distribution certificate and flag whether renewal is needed"
  lane :check_and_renew_certificates do
    setup_ci if ENV['CI']
    ENV["MATCH_READONLY"] = false.to_s

    app_store_connect_api_key(
      key_id: ENV["FASTLANE_KEY_ID"],
      issuer_id: ENV["FASTLANE_ISSUER_ID"],
      key_content: ENV["FASTLANE_KEY"]
    )

    new_certificate_needed = false
    certificates = Spaceship::ConnectAPI::Certificate.all
    distribution_certs = certificates.select { |cert| cert.certificate_type == "DISTRIBUTION" }

    if distribution_certs.empty?
      puts "No Distribution certificates found! Triggering action to create certificate."
      new_certificate_needed = true
    else
      distribution_certs.each do |cert|
        expiration_date = Time.parse(cert.expiration_date)
        puts "Current Distribution Certificate: #{cert.id}, Expiration date: #{expiration_date}"
        if expiration_date < Time.now
          puts "Distribution Certificate #{cert.id} is expired! Triggering renewal."
          new_certificate_needed = true
        else
          puts "Distribution certificate #{cert.id} is valid. No action required."
        end
      end
    end

    file_path = File.expand_path('new_certificate_needed.txt')
    File.write(file_path, new_certificate_needed ? 'true' : 'false')
    puts "Certificate creation or renewal needed: #{File.read(file_path)}"
  end
end
